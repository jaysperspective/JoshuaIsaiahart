// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Gallery {
  id           String   @id @default(cuid())
  title        String
  description  String?
  coverImage   String?
  downloadable Boolean  @default(false)
  slug         String?  @unique
  unlisted     Boolean  @default(false)
  pin          String?
  sortOrder    Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  images       Image[]
}

model Testimonial {
  id        String   @id @default(cuid())
  quote     String
  name      String
  role      String?
  approved  Boolean  @default(false)
  sortOrder Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Metric {
  id        String   @id @default(cuid())
  type      String
  path      String?
  referrer  String?
  visitor   String?
  device    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([type])
}

model Booking {
  id          String   @id @default(cuid())
  date        DateTime
  dateYmd     String?
  time        String
  name        String
  email       String
  phone       String?
  description String
  contactPref String   @default("video")
  status      String   @default("new")
  createdAt   DateTime @default(now())

  @@index([date])
  @@index([createdAt])
}

model SocialVideo {
  id           String   @id @default(cuid())
  caption      String?
  sourceUrl    String
  thumbnailUrl String?
  sortOrder    Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model VideoProject {
  id           String   @id @default(cuid())
  title        String
  description  String?
  videoUrl     String
  thumbnailUrl String?
  sortOrder    Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Image {
  id        String   @id @default(cuid())
  filename  String
  path      String
  caption   String?
  order     Int      @default(0)
  selected  Boolean  @default(false)
  galleryId String
  gallery   Gallery  @relation(fields: [galleryId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

// Blog/posts and site settings. These tables already exist in the production
// DB (created via prisma/migrations/{add_blog_model,add_blog_and_settings})
// but were missing from this schema, so the generated client couldn't expose
// them and every prisma.blog / prisma.settings call failed. Fields mirror the
// migration SQL exactly. Do NOT `prisma db push` this DB — only `prisma generate`.
model Blog {
  id        String   @id @default(cuid())
  title     String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Settings {
  id           String @id @default(cuid())
  instagramUrl String @default("")
  linkedinUrl  String @default("")
  youtubeUrl   String @default("")
}
